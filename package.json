{
  "name": "redoc-express-maintained",
  "version": "2.1.2",
  "description": "Community-maintained fork of redoc-express. Express middleware for OpenAPI/Swagger documentation with compatibility fixes.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins/index.js",
      "require": "./dist/plugins/index.js",
      "types": "./dist/plugins/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "format:check": "prettier --check \"**/*.ts\""
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moltivie/redoc-express-maintained.git"
  },
  "keywords": [
    "redoc-swagger-ui-express-middleware"
  ],
  "author": "Moltivie",
  "contributors": [
    "Aung Myo Kyaw (original author)",
    "Muhammed Tanrikulu (contributor)",
    "Aaron Hipple (contributor)",
    "Moltivie (maintainer)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Moltivie/redoc-express-maintained/issues"
  },
  "homepage": "https://github.com/Moltivie/redoc-express-maintained#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "xss": "^1.0.15"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
